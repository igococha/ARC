<project name="ARC" default="build" basedir=".">

    <description>
        Build file for the ARC BEAST 2 package (Additive Relaxed Clock).

        Compiles against BEAST 2.7. It will use a sibling ../beast2 checkout if
        there is one -- reusing its compiled classes when present -- and
        otherwise downloads the pinned BEAST source from GitHub, so a bare
        clone builds unaided. That is what makes CI a three-line workflow.

        Targets:
          ant build     package zip in dist/, ready to install or release
          ant test      run the unit tests
          ant install   install into the local BEAST package directory
          ant clean     remove all build output
    </description>

    <property environment="env"/>

    <!-- Project layout -->
    <property name="src"         location="src"/>
    <property name="test"        location="test"/>
    <property name="lib"         location="lib"/>
    <property name="examples"    location="examples"/>
    <property name="fxtemplates" location="fxtemplates"/>

    <!-- BEAST 2 to build against. Pinned rather than tracking master: master
         is heading for 2.8, and version.xml declares atmost 2.7.9. The tag is
         v2.7.7 but GitHub strips the leading v from the archive directory. -->
    <property name="beast-tag"     value="v2.7.7"/>
    <property name="beast-dirname" value="beast2-2.7.7"/>
    <property name="local-beast"   location="../beast2"/>

    <!-- BEAST 2.7 requires Java 17 -->
    <property name="releaseVersion" value="17"/>

    <!-- Build output -->
    <property name="build"        location="build"/>
    <property name="build-beast"  location="build-beast"/>
    <property name="beast-source" location="beast-source"/>
    <property name="build-test"   location="build-test"/>
    <property name="test-reports" location="test-reports"/>
    <property name="dist"         location="dist"/>
    <property name="pack"         location="${dist}/package"/>

    <target name="init">
        <available file="version.xml" property="versionAvailable"/>
        <fail unless="versionAvailable" message="Required file version.xml does not exist."/>

        <xmlproperty file="version.xml" prefix="fromVersionFile"/>
        <property name="projName"    value="${fromVersionFile.package(name)}"/>
        <property name="projVersion" value="${fromVersionFile.package(version)}"/>
        <property name="fullName"    value="${projName}.v${projVersion}"/>

        <mkdir dir="${build}"/>
        <mkdir dir="${dist}"/>
        <mkdir dir="${lib}"/>
        <mkdir dir="${examples}"/>
        <mkdir dir="${fxtemplates}"/>
    </target>


    <!-- ==================== Acquire BEAST 2 ==================== -->
    <!-- Three strategies, in order of preference. Ant properties are
         write-once, so whichever target runs first fixes beast.classes
         and beast.lib for the rest of the build. -->

    <target name="find-beast" depends="init">
        <available file="${local-beast}/build" type="dir" property="haveLocalBeastBuild"/>
        <available file="${local-beast}"       type="dir" property="haveLocalBeast"/>
    </target>

    <!-- 1. A sibling checkout that has already been compiled. -->
    <target name="beast-local-build" depends="find-beast" if="haveLocalBeastBuild">
        <echo>Using compiled BEAST classes at ${local-beast}/build</echo>
        <property name="beast.classes" location="${local-beast}/build"/>
        <property name="beast.lib"     location="${local-beast}/lib"/>
    </target>

    <!-- 2. A sibling checkout that has not been compiled yet. -->
    <target name="beast-local-source" depends="beast-local-build"
            if="haveLocalBeast" unless="haveLocalBeastBuild">
        <echo>Compiling BEAST source found at ${local-beast}</echo>
        <mkdir dir="${build-beast}"/>
        <javac srcdir="${local-beast}/src" destdir="${build-beast}"
               release="${releaseVersion}" includeantruntime="false"
               encoding="UTF-8" fork="yes">
            <classpath>
                <fileset dir="${local-beast}/lib" includes="**/*.jar"/>
            </classpath>
        </javac>
        <property name="beast.classes" location="${build-beast}"/>
        <property name="beast.lib"     location="${local-beast}/lib"/>
    </target>

    <!-- 3. No local checkout: fetch the pinned source from GitHub. -->
    <target name="beast-remote" depends="find-beast" unless="haveLocalBeast">
        <echo>No BEAST source at ${local-beast}; downloading ${beast-tag} from GitHub.</echo>
        <mkdir dir="${beast-source}"/>
        <get src="https://github.com/CompEvol/beast2/archive/refs/tags/${beast-tag}.zip"
             dest="${beast-source}/beast.zip" skipexisting="true"/>
        <unzip src="${beast-source}/beast.zip" dest="${beast-source}"/>
        <mkdir dir="${build-beast}"/>
        <javac srcdir="${beast-source}/${beast-dirname}/src" destdir="${build-beast}"
               release="${releaseVersion}" includeantruntime="false"
               encoding="UTF-8" fork="yes">
            <classpath>
                <fileset dir="${beast-source}/${beast-dirname}/lib" includes="**/*.jar"/>
            </classpath>
        </javac>
        <property name="beast.classes" location="${build-beast}"/>
        <property name="beast.lib"     location="${beast-source}/${beast-dirname}/lib"/>
    </target>

    <target name="beast" depends="beast-local-build,beast-local-source,beast-remote">
        <path id="beast.path">
            <pathelement path="${beast.classes}"/>
            <fileset dir="${beast.lib}" includes="**/*.jar"/>
        </path>
    </target>


    <!-- ==================== Compile ==================== -->

    <target name="compile" depends="beast">
        <javac srcdir="${src}" destdir="${build}"
               release="${releaseVersion}" includeantruntime="false"
               encoding="UTF-8" fork="yes" debug="true">
            <compilerarg value="-Xlint:all"/>
            <classpath>
                <path refid="beast.path"/>
                <fileset dir="${lib}" includes="*.jar" erroronmissingdir="false"/>
            </classpath>
        </javac>
    </target>

    <target name="copy-resources" depends="compile">
        <copy todir="${build}" failonerror="false">
            <fileset dir="${src}" includes="**/*.png,**/*.properties"/>
        </copy>
    </target>


    <!-- ==================== Test ==================== -->

    <target name="compile-test" depends="compile,copy-resources">
        <mkdir dir="${build-test}"/>
        <mkdir dir="${test-reports}"/>
        <javac srcdir="${test}" destdir="${build-test}"
               release="${releaseVersion}" includeantruntime="false"
               encoding="UTF-8" fork="yes" debug="true">
            <classpath>
                <pathelement path="${build}"/>
                <path refid="beast.path"/>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="compile-test">
        <junit printsummary="yes" failureproperty="testFailed" showoutput="false">
            <classpath>
                <pathelement path="${build}"/>
                <pathelement path="${build-test}"/>
                <path refid="beast.path"/>
            </classpath>
            <batchtest fork="yes" todir="${test-reports}">
                <fileset dir="${test}" includes="**/*Test.java"/>
                <formatter type="plain"/>
            </batchtest>
        </junit>
        <fail if="testFailed" status="1" message="Unit tests failed."/>
    </target>


    <!-- ==================== Package ==================== -->

    <target name="build" depends="compile,copy-resources"
            description="build the installable package zip">
        <mkdir dir="${pack}"/>
        <mkdir dir="${pack}/lib"/>
        <mkdir dir="${pack}/examples"/>
        <mkdir dir="${pack}/fxtemplates"/>

        <!-- Class jar. PackageHealthChecker expects it under lib/. -->
        <jar jarfile="${pack}/lib/${fullName}.jar" basedir="${build}"/>

        <!-- Source jar at top level. The checker cross-checks that every
             class in the class jar has a matching .java here, and vice versa. -->
        <jar jarfile="${pack}/${fullName}.src.jar" basedir="${src}"/>

        <copy todir="${pack}/lib">
            <fileset dir="${lib}" includes="*.jar"/>
        </copy>
        <copy todir="${pack}/examples">
            <fileset dir="${examples}" includes="**/*.xml,**/*.fasta,**/*.nex"/>
        </copy>
        <copy todir="${pack}/fxtemplates">
            <fileset dir="${fxtemplates}" includes="*.xml"/>
        </copy>

        <copy file="README.md"   tofile="${pack}/README"/>
        <copy file="COPYING"     todir="${pack}"/>
        <copy file="version.xml" todir="${pack}"/>

        <zip destfile="${dist}/${fullName}.zip" basedir="${pack}"/>
        <delete dir="${pack}"/>

        <echo message="Package built: ${dist}/${fullName}.zip"/>
    </target>


    <!-- ==================== Install locally ==================== -->
    <!-- Unpacks into the BEAST package directory so the package can be run
         and checked with:
           applauncher PackageHealthChecker -package ARC -namespace arc -->

    <target name="install" depends="build"
            description="install the package into the local BEAST package directory">
        <condition property="beast.user.dir" value="${user.home}/.beast/2.7">
            <os family="unix"/>
        </condition>
        <condition property="beast.user.dir" value="${user.home}/Library/Application Support/BEAST/2.7">
            <os family="mac"/>
        </condition>
        <condition property="beast.user.dir" value="${user.home}/BEAST/2.7">
            <os family="windows"/>
        </condition>
        <fail unless="beast.user.dir" message="Could not determine the BEAST package directory for this OS."/>

        <delete dir="${beast.user.dir}/${projName}"/>
        <mkdir dir="${beast.user.dir}/${projName}"/>
        <unzip src="${dist}/${fullName}.zip" dest="${beast.user.dir}/${projName}"/>
        <echo message="Installed ${fullName} to ${beast.user.dir}/${projName}"/>
    </target>


    <target name="clean" description="remove all build output">
        <delete dir="${build}"/>
        <delete dir="${build-beast}"/>
        <delete dir="${build-test}"/>
        <delete dir="${beast-source}"/>
        <delete dir="${test-reports}"/>
        <delete dir="${dist}"/>
    </target>

</project>
